# Guardian Cloud Connector — configuration reference.
# Copy to .env and fill in real values. NEVER commit a real .env.

# ---- Required ---------------------------------------------------------------

# PostgreSQL connection URL. The role should own only this service's database.
DATABASE_URL=postgres://guardian:CHANGE_ME@localhost:5432/guardian?sslmode=disable

# ---- Listeners --------------------------------------------------------------

CONNECTOR_HTTP_ADDR=:8080
CONNECTOR_GRPC_ADDR=:9090

# ---- Edge device auth -------------------------------------------------------

# Bearer token Guardian edge devices send on /v1/edge/*.
# Empty disables edge auth (development only; logged loudly at startup).
EDGE_API_TOKEN=CHANGE_ME

# ---- Secrets at rest --------------------------------------------------------

# 32-byte AES-256 key, hex-encoded (64 hex chars), used to encrypt provider
# OAuth tokens in the database. Generate with:  openssl rand -hex 32
TOKEN_CIPHER_KEY=

# ---- BetaGrid (simulated webhook provider) ----------------------------------

# Shared HMAC-SHA256 secret for webhook signature verification.
# Empty disables the BetaGrid webhook endpoint (503).
BETAGRID_WEBHOOK_SECRET=
# Maximum accepted clock skew / delivery age for signed webhooks.
WEBHOOK_MAX_SKEW=5m

# ---- AlphaSense (simulated OAuth2 + polling provider) -----------------------

# Empty ALPHASENSE_BASE_URL disables polling entirely.
ALPHASENSE_BASE_URL=
ALPHASENSE_TOKEN_URL=
ALPHASENSE_CLIENT_ID=
ALPHASENSE_CLIENT_SECRET=
ALPHASENSE_POLL_INTERVAL=30s

# ---- Tuning -----------------------------------------------------------------

# How long an undelivered command stays PENDING before it is failed.
COMMAND_TTL=24h
# Per-request timeout on the HTTP API.
REQUEST_TIMEOUT=15s
# Maximum accepted request body size in bytes.
MAX_BODY_BYTES=1048576
# debug | info | warn | error
LOG_LEVEL=info
